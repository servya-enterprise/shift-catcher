# Copy to .env for local Docker Compose. Never commit real credentials.
ADMIN_API_TOKEN=replace-with-a-long-random-local-token
DB_NAME=shift_catcher
DB_USER=shift_catcher
DB_PASSWORD=replace-with-a-long-random-local-password
DB_PORT=5432
APP_PORT=8080

# GREEN-API is configured only from WP-POC-002 onward.
GREEN_API_API_URL=
GREEN_API_INSTANCE_ID=
GREEN_API_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=

# --- VPS production only (docker-compose.prod.yml). Not used by local compose.yaml. ---
# Public domain already pointed (DNS A record) at the VPS IP. Caddy issues the TLS
# certificate for this host automatically via Let's Encrypt.
DOMAIN=
# Email Let's Encrypt uses for expiry/abuse notices. Optional but recommended.
ACME_EMAIL=
